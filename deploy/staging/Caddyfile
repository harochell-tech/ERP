# E-B03-2: HTTPS only. Port 80 stays closed, so Let's Encrypt validates with TLS-ALPN on 443.
{$STAGING_HOST} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy api:8080
}

# E-PROD-3: the former address keeps answering and sends every request, path and query included, to the current one, so the QR
# already printed (delivery notes, certificates, rack labels) still open. Without LEGACY_HOST the block is a host nobody asks for.
{$LEGACY_HOST:legacy.localhost} {
	header Strict-Transport-Security "max-age=31536000"
	redir https://{$STAGING_HOST}{uri} 308
}
