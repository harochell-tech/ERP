<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Rochell.Sales</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Module rule (E-VS3-02-2): Sales may use Platform, Finance, Inventory, MasterData and Tax (as Procurement). -->
    <ProjectReference Include="..\Rochell.Platform\Rochell.Platform.csproj" />
    <ProjectReference Include="..\Rochell.Finance\Rochell.Finance.csproj" />
    <ProjectReference Include="..\Rochell.Inventory\Rochell.Inventory.csproj" />
    <ProjectReference Include="..\Rochell.MasterData\Rochell.MasterData.csproj" />
    <ProjectReference Include="..\Rochell.Tax\Rochell.Tax.csproj" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Fluid.Core" />
  </ItemGroup>
  <ItemGroup>
    <!-- PRT-01 (E-PRT-01-4): the built-in «Rochell» print formats. -->
    <EmbeddedResource Include="Printing/Templates/*.liquid" />
    <EmbeddedResource Include="Printing/Assets/*" />
  </ItemGroup>
</Project>
