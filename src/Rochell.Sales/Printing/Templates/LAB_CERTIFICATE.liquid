{%- comment -%} Certificado de resistencia a compresión (LAB-1 §4.6, E-LAB1-03-2…8): ASTM C140, por lote y fecha de rotura, con QR de verificación. {%- endcomment -%}
{% if marca_agua %}<div class="watermark" data-testid="watermark" role="note" aria-label="Marca de agua: {{ marca_agua }}"><span>{{ marca_agua }}</span></div>{% endif %}
{% if logo %}<img class="logo" src="{{ logo.src }}" alt="{{ emisor.nombre }}">{% endif %}
{% if formato.textos.encabezado %}<p class="texto-encabezado">{{ formato.textos.encabezado }}</p>{% endif %}
<header class="print-head">
  <div>
    <strong>{{ emisor.nombre }}</strong>
    <div>RNC <span class="mono">{{ emisor.rnc }}</span></div>
    <div>Laboratorio de calidad · planta {{ lote.planta }}</div>
  </div>
  <div class="print-number">
    <h1>Certificado de resistencia a compresión</h1>
    <div>No. <span class="mono" data-testid="certificate-no">{{ certificado.numero }}</span></div>
    <div>Emitido el {{ certificado.emitido }} · ASTM C140</div>
  </div>
</header>
<dl class="facts">
  <dt>Cliente</dt>
  <dd data-testid="certificate-customer">{% if conduce %}{{ conduce.cliente }}{% if conduce.rnc %} · RNC <span class="mono">{{ conduce.rnc }}</span>{% endif %}{% else %}—{% endif %}</dd>
  <dt>Obra</dt>
  <dd>{% if conduce and conduce.obra %}{{ conduce.obra }}{% else %}—{% endif %}</dd>
  <dt>Producto</dt>
  <dd>{{ lote.producto }}</dd>
  <dt>Procedencia</dt>
  <dd data-testid="certificate-origin">Lote <span class="mono">{{ lote.codigo }}</span> · máquina {{ lote.maquina }} · turno {{ lote.turno }} · producido el {{ lote.produccion }}</dd>
  <dt>Fecha de rotura</dt>
  <dd>{{ certificado.rotura }}</dd>
  <dt>Encargado</dt>
  <dd>{{ firmante.nombre }}{% if firmante.cargo %}, {{ firmante.cargo }}{% endif %}</dd>
  <dt>Equipo</dt>
  <dd>{{ equipo }}</dd>
</dl>
<table class="lineas">
  <thead><tr>{% for c in formato.columnas %}<th class="{{ c.clase }}" style="{{ c.estilo }}">{{ c.titulo }}</th>{% endfor %}</tr></thead>
  <tbody>
  {% for l in lineas %}<tr data-testid="certificate-specimen">{% for c in formato.columnas %}<td class="{{ c.clase }}" style="{{ c.estilo }}">{{ l[c.clave] }}</td>{% endfor %}</tr>
  {% endfor %}
  </tbody>
</table>
<dl class="facts">
  <dt>Probetas</dt>
  <dd data-testid="certificate-specimens">{{ resumen.probetas }}</dd>
  <dt>Promedio</dt>
  <dd data-testid="certificate-average">{{ resumen.promedio_kgcm2 }} kg/cm² · {{ resumen.promedio_mpa }} MPa</dd>
  <dt>Mínimo</dt>
  <dd>{{ resumen.minimo_kgcm2 }} kg/cm² · {{ resumen.minimo_mpa }} MPa</dd>
  <dt>Coeficiente de variación</dt>
  <dd>{% if resumen.cv %}{{ resumen.cv }} %{% else %}— (una sola probeta){% endif %}</dd>
  <dt>Absorción y densidad del lote</dt>
  <dd>{% if absorcion %}{{ absorcion.absorcion }} kg/m³ · {{ absorcion.densidad }} kg/m³ ({{ absorcion.bloques }} bloques){% else %}Sin ensayo de absorción{% endif %}</dd>
  <dt>Condición del bloque</dt>
  <dd>{{ resumen.condicion }}</dd>
  <dt>Falla predominante</dt>
  <dd>{{ resumen.falla }}</dd>
</dl>
<p class="muted">Resistencia calculada sobre área bruta. Resultados válidos solo para las unidades ensayadas.</p>
<div class="signature">
  <div><div class="signature-line"></div>{{ firmante.nombre }}{% if firmante.cargo %}<br>{{ firmante.cargo }}{% endif %}</div>
  {% if qr %}<div class="driver-qr" data-testid="certificate-qr"><div class="qr" data-url="{{ qr.url }}">{{ qr.svg | raw }}</div><div>Escanee para verificar este certificado</div></div>{% endif %}
</div>
{% if formato.textos.pie %}<p class="texto-pie muted">{{ formato.textos.pie }}</p>{% endif %}
