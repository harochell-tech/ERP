{%- comment -%} Estado de cuenta (UX4-03 V-19, E-FIS1b-9): movimientos del período, saldo final y proformas abiertas aparte. {%- endcomment -%}
{% if marca_agua %}<div class="watermark" data-testid="watermark" role="note" aria-label="Marca de agua: {{ marca_agua }}"><span>{{ marca_agua }}</span></div>{% endif %}
{% if logo %}<img class="logo" src="{{ logo.src }}" alt="{{ emisor.nombre }}">{% endif %}
{% if formato.textos.encabezado %}<p class="texto-encabezado">{{ formato.textos.encabezado }}</p>{% endif %}
<div class="print-head"><div><h1>Estado de cuenta</h1><p>Del {{ periodo.desde }} al {{ periodo.hasta }} · emitido el {{ periodo.emitido }}</p></div></div>
<dl class="facts">
  <dt>Emisor</dt><dd>{{ emisor.nombre }}</dd>
  <dt>Cliente</dt><dd data-testid="print-statement-customer">{{ cliente.nombre }}{% if cliente.rnc %} · RNC <span class="mono">{{ cliente.rnc }}</span>{% endif %}</dd>
  <dt>Saldo al {{ periodo.hasta }}</dt><dd><strong><span class="mono">RD$ <span data-testid="print-statement-closing">{{ saldos.final }}</span></span></strong></dd>
</dl>
<table class="lineas">
  <thead><tr>{% for c in formato.columnas %}<th class="{{ c.clase }}" style="{{ c.estilo }}">{{ c.titulo }}</th>{% endfor %}</tr></thead>
  <tbody>
  {% for l in lineas %}<tr>{% for c in formato.columnas %}<td class="{{ c.clase }}" style="{{ c.estilo }}">{{ l[c.clave] }}</td>{% endfor %}</tr>
  {% endfor %}
  <tr class="totales">{% for c in formato.columnas %}{% assign t = totales_fila[c.clave] %}<td class="{{ c.clase }}" style="{{ c.estilo }}">{% if forloop.first %}<strong>{{ totales_etiqueta }}</strong>{% elsif t %}<strong><span data-testid="{{ t.testid }}">{{ t.valor }}</span></strong>{% endif %}</td>{% endfor %}</tr>
  </tbody>
</table>
{% if proformas.size > 0 %}
<section data-testid="statement-proformas">
  <h2>Proformas abiertas</h2>
  <p class="muted">Entregas que esperan su comprobante fiscal. No forman parte del saldo de arriba; se cobran contra la proforma.</p>
  <table>
    <thead><tr><th>Proforma</th><th>Conduce</th><th>Fecha</th><th>Vence</th><th class="num">Total (RD$)</th><th class="num">Cobrado (RD$)</th><th class="num">Saldo (RD$)</th><th class="num">Depósito ITBIS (RD$)</th></tr></thead>
    <tbody>
    {% for f in proformas %}
      <tr><td class="mono">{{ f.numero }}</td><td class="mono">{{ f.conduce }}</td><td>{{ f.fecha }}</td><td>{{ f.vence }}</td><td class="num">{{ f.total }}</td><td class="num">{{ f.cobrado }}</td><td class="num">{{ f.saldo }}</td><td class="num">{{ f.deposito }}</td></tr>
    {% endfor %}
      <tr><th colspan="6">Saldo en proformas</th><td class="num"><span data-testid="statement-proforma-balance">{{ saldos.proformas }}</span></td><td></td></tr>
    </tbody>
  </table>
</section>
{% endif %}
<p class="muted">Si encuentra alguna diferencia, comuníquese con nuestro departamento de cobros. Documento no fiscal.</p>
{% if formato.textos.cuentas %}<p class="texto-cuentas"><strong>Cuentas para pagos:</strong> {{ formato.textos.cuentas }}</p>{% endif %}
{% if formato.textos.pie %}<p class="texto-pie muted">{{ formato.textos.pie }}</p>{% endif %}
