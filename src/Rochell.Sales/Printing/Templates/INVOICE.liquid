{%- comment -%} Factura (E-VS4-04-4, E-ENT-9): emisor, cliente, líneas, totales, timbre del e-CF con su QR y los QR del chofer de las entregas en tránsito. {%- endcomment -%}
{% if marca_agua %}<div class="watermark" data-testid="watermark" role="note" aria-label="Marca de agua: {{ marca_agua }}"><span>{{ marca_agua }}</span></div>{% endif %}
<header class="print-head">
  <div>
    <strong>{{ emisor.nombre }}</strong>
    {% if emisor.nombre_comercial %}<div>{{ emisor.razon_social }}</div>{% endif %}
    <div>RNC <span class="mono">{{ emisor.rnc }}</span></div>
    {% if emisor.direccion %}<div>{{ emisor.direccion }}</div>{% endif %}
    {% if emisor.contacto %}<div>{{ emisor.contacto }}</div>{% endif %}
  </div>
  <div class="print-number">
    <h1>{{ factura.titulo }}</h1>
    <div>e-NCF <span class="mono" data-testid="print-encf">{{ factura.encf }}</span></div>
    <div>Factura <span class="mono">{{ factura.numero }}</span> del {{ factura.fecha }}</div>
    {% if factura.vence %}<div>Vence el {{ factura.vence }}</div>{% endif %}
  </div>
</header>
<dl class="facts">
  <dt>Cliente</dt>
  <dd>{{ cliente.nombre }}{% if cliente.rnc %} · RNC / cédula <span class="mono">{{ cliente.rnc }}</span>{% endif %}{% if cliente.pasaporte %} · pasaporte {{ cliente.pasaporte }}{% endif %}</dd>
  {% if exencion %}<dt>Exención</dt><dd>{{ exencion.regimen }} certificación {{ exencion.certificado }} · {{ exencion.proyecto }}</dd>{% endif %}
</dl>
<table>
  <thead><tr><th class="num">#</th><th>Descripción</th><th>Unidad</th><th class="num">Cantidad</th><th class="num">Precio (RD$)</th><th class="num">ITBIS (RD$)</th><th class="num">Importe (RD$)</th></tr></thead>
  <tbody>
  {% for l in lineas %}
    <tr><td class="num">{{ l.linea }}</td><td>{{ l.codigo }} — {{ l.descripcion }}<span class="muted"> · conduce {{ l.conduce }}</span></td><td>{{ l.unidad }}</td><td class="num">{{ l.cantidad }}</td><td class="num">{{ l.precio }}</td><td class="num">{{ l.itbis }}</td><td class="num">{{ l.importe }}</td></tr>
  {% endfor %}
  </tbody>
  <tfoot>
    <tr><th colspan="6" class="num">Subtotal</th><td class="num">{{ totales.neto }}</td></tr>
    <tr><th colspan="6" class="num">ITBIS</th><td class="num">{{ totales.itbis }}</td></tr>
    <tr><th colspan="6" class="num">Total</th><td class="num"><strong>RD$ <span data-testid="print-total">{{ totales.total }}</span></strong></td></tr>
  </tfoot>
</table>
{% if ecf %}<div class="ecf-print" data-testid="print-ecf"><div class="qr" data-testid="ecf-qr">{{ ecf.qr | raw }}</div><div><div>Código de seguridad: <span class="mono">{{ ecf.codigo_seguridad }}</span></div><div>Fecha de firma digital: {{ ecf.fecha_firma }}</div></div></div>{% endif %}
{% if qrs_chofer.size > 0 %}<div class="driver-qrs">{% for q in qrs_chofer %}<div class="driver-qr" data-testid="invoice-driver-qr"><div class="qr" data-url="{{ q.url }}">{{ q.svg | raw }}</div><div>Conduce {{ q.conduce }}: chofer, escanee para confirmar la entrega</div></div>{% endfor %}</div>{% endif %}
