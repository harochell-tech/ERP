{%- comment -%} Facturas pendientes de un cliente por antigüedad (E-VS3-09-1, E-FIS1b-3). {%- endcomment -%}
{% if marca_agua %}<div class="watermark" data-testid="watermark" role="note" aria-label="Marca de agua: {{ marca_agua }}"><span>{{ marca_agua }}</span></div>{% endif %}
{% if logo %}<img class="logo" src="{{ logo.src }}" alt="{{ emisor.nombre }}">{% endif %}
{% if formato.textos.encabezado %}<p class="texto-encabezado">{{ formato.textos.encabezado }}</p>{% endif %}
<div class="print-head"><div><h1>Facturas pendientes</h1><p>Al {{ corte }}</p></div></div>
<dl class="facts">
  <dt>Emisor</dt><dd>{{ emisor.nombre }} · RNC <span class="mono">{{ emisor.rnc }}</span></dd>
  <dt>Cliente</dt><dd>{{ cliente.nombre }}</dd>
</dl>
<table class="lineas">
  <thead><tr>{% for c in formato.columnas %}<th class="{{ c.clase }}" style="{{ c.estilo }}">{{ c.titulo }}</th>{% endfor %}</tr></thead>
  <tbody>
  {% for l in lineas %}<tr>{% for c in formato.columnas %}<td class="{{ c.clase }}" style="{{ c.estilo }}">{{ l[c.clave] }}</td>{% endfor %}</tr>
  {% else %}<tr><td colspan="{{ formato.columnas.size }}">Sin facturas pendientes.</td></tr>
  {% endfor %}
  <tr class="totales">{% for c in formato.columnas %}{% assign t = totales_fila[c.clave] %}<td class="{{ c.clase }}" style="{{ c.estilo }}">{% if forloop.first %}<strong>{{ totales_etiqueta }}</strong>{% elsif t %}<strong><span data-testid="{{ t.testid }}">{{ t.valor }}</span></strong>{% endif %}</td>{% endfor %}</tr>
  </tbody>
</table>
<table>
  <thead><tr><th class="num">Al día (RD$)</th>{% for t in tramos %}<th class="num">{{ t }}</th>{% endfor %}<th class="num">A su favor (RD$)</th><th class="num">Neto (RD$)</th></tr></thead>
  <tbody><tr><td class="num">{{ totales.al_dia }}</td>{% for v in totales.por_tramo %}<td class="num">{{ v }}</td>{% endfor %}<td class="num">{{ totales.a_favor }}</td><td class="num">{{ totales.neto }}</td></tr></tbody>
</table>
{% if proformas.size > 0 %}
<h2>Proformas abiertas</h2>
<p class="muted">Entregas que esperan su comprobante fiscal; se cobran contra la proforma.</p>
<table>
  <thead><tr><th>Proforma</th><th>Conduce</th><th>Fecha</th><th>Vence</th><th class="num">Días vencida</th><th class="num">Saldo (RD$)</th></tr></thead>
  <tbody>
  {% for f in proformas %}
    <tr><td class="mono">{{ f.numero }}</td><td class="mono">{{ f.conduce }}</td><td>{{ f.fecha }}</td><td>{{ f.vence }}</td><td class="num">{{ f.dias }}</td><td class="num">{{ f.saldo }}</td></tr>
  {% endfor %}
    <tr><th colspan="5">Saldo en proformas</th><td class="num">{{ totales.proformas }}</td></tr>
  </tbody>
</table>
{% endif %}
<p class="muted">Si ya realizó el pago, comuníquese con nuestro departamento de cobros con el comprobante.</p>
{% if formato.textos.cuentas %}<p class="texto-cuentas"><strong>Cuentas para pagos:</strong> {{ formato.textos.cuentas }}</p>{% endif %}
{% if formato.textos.pie %}<p class="texto-pie muted">{{ formato.textos.pie }}</p>{% endif %}
