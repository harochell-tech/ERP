{%- comment -%} Cotización (E-QUO1-04-5, E-UX3-10): emisor, cliente, líneas con ITBIS informativo, totales, validez y condiciones. {%- endcomment -%}
{% if marca_agua %}<div class="watermark" data-testid="watermark" role="note" aria-label="Marca de agua: {{ marca_agua }}"><span>{{ marca_agua }}</span></div>{% endif %}
{% if logo %}<img class="logo" src="{{ logo.src }}" alt="{{ emisor.nombre }}">{% endif %}
{% if formato.textos.encabezado %}<p class="texto-encabezado">{{ formato.textos.encabezado }}</p>{% endif %}
<h1>Cotización {{ cotizacion.numero }}</h1>
<p>Emitida el {{ cotizacion.fecha }} · <strong data-testid="print-valid-until">válida hasta el {{ cotizacion.valida_hasta }}</strong></p>
<dl class="facts">
  <dt>Suplidor</dt><dd>{{ emisor.nombre }} · RNC <span class="mono">{{ emisor.rnc }}</span></dd>
  <dt>Cliente</dt><dd data-testid="print-customer">{{ cliente.nombre }}{% if cliente.rnc %} · RNC <span class="mono">{{ cliente.rnc }}</span>{% endif %}</dd>
  {% if cotizacion.referencia %}<dt>Su referencia</dt><dd>{{ cotizacion.referencia }}</dd>{% endif %}
  <dt>Entrega</dt><dd>{{ cotizacion.termino }}{% if cotizacion.obra %} · obra: {{ cotizacion.obra }}{% endif %}</dd>
</dl>
<table class="lineas">
  <thead><tr>{% for c in formato.columnas %}<th class="{{ c.clase }}" style="{{ c.estilo }}">{{ c.titulo }}</th>{% endfor %}</tr></thead>
  <tbody>
  {% for l in lineas %}<tr{% if l.testid %} data-testid="{{ l.testid }}"{% endif %}>{% for c in formato.columnas %}<td class="{{ c.clase }}" style="{{ c.estilo }}">{{ l[c.clave] }}</td>{% endfor %}</tr>
  {% endfor %}
  {% if totales_fila %}<tr class="totales">{% for c in formato.columnas %}{% assign t = totales_fila[c.clave] %}<td class="{{ c.clase }}" style="{{ c.estilo }}">{% if forloop.first %}<strong>{{ totales_etiqueta }}</strong>{% elsif t %}<strong><span data-testid="{{ t.testid }}">{{ t.valor }}</span></strong>{% endif %}</td>{% endfor %}</tr>{% endif %}
  </tbody>
</table>
{% if cotizacion.notas %}<p><strong>Notas:</strong> {{ cotizacion.notas }}</p>{% endif %}
<h2>Condiciones generales</h2>
<p class="muted" data-testid="print-conditions">{% if formato.textos.condiciones %}{{ formato.textos.condiciones }}{% else %}Precios en pesos dominicanos, sin ITBIS salvo indicación; el ITBIS mostrado es informativo, calculado con las reglas vigentes a la fecha de la cotización. Sujeto a disponibilidad. Documento no fiscal.{% endif %}</p>
<div class="signature">
  <div><div class="signature-line"></div>Por el suplidor</div>
  <div><div class="signature-line"></div>Aceptación del cliente</div>
</div>
{% if formato.textos.cuentas %}<p class="texto-cuentas"><strong>Cuentas para pagos:</strong> {{ formato.textos.cuentas }}</p>{% endif %}
{% if formato.textos.pie %}<p class="texto-pie muted">{{ formato.textos.pie }}</p>{% endif %}
