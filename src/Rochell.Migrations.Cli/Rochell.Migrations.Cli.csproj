<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rochell.Migrations.Cli</RootNamespace>
    <AssemblyName>rochell-migrate</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rochell.Migrations\Rochell.Migrations.csproj" />
    <ProjectReference Include="..\Rochell.Platform\Rochell.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only production migrations are shipped. tests/migrations must never be copied here (TST-01). -->
    <None Include="..\..\db\migrations\*.sql" Link="migrations\main\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
